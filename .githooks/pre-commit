#!/bin/sh
# Reglas de rama antes de cada commit. Ver CONTRIBUTING.md, secciones 1, 3 y 6.

branch=$(git symbolic-ref --short -q HEAD)

# Durante un merge (por ejemplo, al terminar una rama con git flow) el commit lo genera git.
if [ -f "$(git rev-parse --git-dir)/MERGE_HEAD" ]; then
  exit 0
fi

if [ "$branch" = "main" ]; then
  echo "commit rechazado: no se programa directamente en main."
  echo "  Crea una rama con git flow (CONTRIBUTING.md, sección 3)."
  exit 1
fi

valid='^(feature/[a-z0-9]+(-[a-z0-9]+)*|test/[a-z0-9]+(-[a-z0-9]+)*|(release|hotfix)/v[0-9]+\.[0-9]+\.[0-9]+)$'
if ! printf '%s\n' "$branch" | grep -Eq "$valid"; then
  echo "commit rechazado: el nombre de la rama '$branch' no cumple la convención."
  echo "  feature/<nombre-kebab> | test/<nombre-kebab> | release/vX.Y.Z | hotfix/vX.Y.Z"
  echo "  Ver CONTRIBUTING.md, sección 3."
  exit 1
fi

case "$branch" in
  feature/*|hotfix/*)
    specs=$(git diff --cached --name-only | grep -E '(^|/)specs/|\.spec\.[jt]sx?$' || true)
    if [ -n "$specs" ]; then
      echo "commit rechazado: las ramas feature/ y hotfix/ no pueden crear, modificar ni borrar specs:"
      echo "$specs" | sed 's/^/  /'
      echo "  Los tests van en una rama test/ fusionada antes (CONTRIBUTING.md, sección 6)."
      exit 1
    fi ;;
esac

exit 0
